{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": ".",
        "strict": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"],
        "lib": ["ES2022", "DOM"],
        "noCheck": true,
        "noEmitOnError": true
    },
    "include": ["main.ts", "types/**/*.d.ts"],
    "exclude": ["node_modules"]
}
