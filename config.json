{
    "applicationName": "js_hmi",
    "_serverLogLevel": "INFO",
    "serverLogLevel": "DEBUG",
    "_clientLogLevel": "INFO",
    "clientLogLevel": "DEBUG",
    "staticClientFiles": [],
    "webServerPort": 8080,
    "webSocketPort": 8081,
    "autoConnect": true,
    "serverCycleMillis": 250,
    "clientRequestAnimationFrameCycle": 3,
    "_secureKeyFile": "./cert/cert.key",
    "_secureCertFile": "./cert/cert.cert",
    "closedConnectionDisposeTimeout": 6000,
    "sendObserverRequestDelay": 90,
    "dataConnectorSendDelay": 90,
    "clientAccessPointUnregisterObserverDelay": 2000,
    "serverAccessPointUnregisterObserverDelay": 2000,
    "_touch_info": "The following parameter just switches the style of the scrollbar",
    "touch": false,
    "scrollbar_config": "./ui/scrollbar-desktop.css",
    "scrollbar_hmi": "./ui/scrollbar-touch.css",
    "simulationCycleMillis": 500,
    "minimized": true,
    "staticWebServerDirectories": {
        "images": "./images"
    },
    "staticWebServerFiles": [
        "./ui/hmi_styles.css"
    ],
    "favicon": "images/favicon.ico"
}